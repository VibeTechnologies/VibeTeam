# OpenHands Agent Service Dockerfile - Development Mode
# Works with git-sync sidecar - code mounted at /code/current

FROM python:3.12-slim

WORKDIR /app

# Install runtime + dev dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    bash \
    tar \
    build-essential \
    sudo \
    jq \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI for agent operations
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl for k8s operations
RUN KUBECTL_VERSION="v1.31.4" \
    && curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl \
    && rm kubectl \
    && curl -fsSL https://sentry.io/get-cli/ | bash

# Copy and install requirements first (cached layer)
COPY agent_service/openhands/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Create non-root user
RUN useradd -m -u 1000 vibeteam \
    && usermod -aG sudo vibeteam \
    && echo "vibeteam ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/vibeteam \
    && chmod 0440 /etc/sudoers.d/vibeteam
USER vibeteam

# Environment variables
# PYTHONPATH is set by k8s patch to /code/current (git-sync mount)
ENV AZURE_API_KEY=""
ENV AZURE_API_BASE=""
ENV AZURE_API_VERSION="2024-08-01-preview"
ENV DATABASE_URL=""
ENV PORT="8080"
ENV HOST="0.0.0.0"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run server - code comes from git-sync volume at /code/current
CMD ["python", "-m", "uvicorn", "agent_service.openhands.server:app", "--host", "0.0.0.0", "--port", "8080"]
