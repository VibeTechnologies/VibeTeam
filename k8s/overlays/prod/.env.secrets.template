# VibeTeam Secrets Template
# Copy to .env.secrets and fill in values before deploying
#
# SENTRY_AUTH_TOKEN: Create at https://vibetechnologies.sentry.io/settings/auth-tokens/
#   Required scopes: project:read, project:write, issue:read, issue:write
#
# GITHUB_TOKEN: Create at https://github.com/settings/tokens
#   Required scopes: repo (for issue creation)

SENTRY_AUTH_TOKEN=<sentry-api-token>
GITHUB_TOKEN=<github-pat-with-repo-scope>
