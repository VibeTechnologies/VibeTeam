# Example secrets file for kustomize secretGenerator
# Copy to .env.secrets and fill in actual values
# This file is used by k8s/overlays/prod/kustomization.yaml

# LLM Configuration
AZURE_API_KEY=your-azure-openai-api-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# GitHub Integration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Sentry Integration
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_CLIENT_SECRET=your-sentry-client-secret

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key

# Database
DATABASE_URL=postgresql://user:pass@host:5432/vibeteam
