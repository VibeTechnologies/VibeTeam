# VibeTeam Environment Configuration
# Copy to .env and fill in values

# Azure OpenAI Configuration (required for gpt-5.2 model)
# Get these from Azure Portal > AI Services > info-mjnxtt51-eastus2
AZURE_API_KEY=your-azure-api-key
AZURE_API_BASE=https://info-mjnxtt51-eastus2.cognitiveservices.azure.com/
AZURE_API_VERSION=2024-08-01-preview

# Langfuse Observability (optional)
# Get keys from https://langfuse.vibebrowser.app
LANGFUSE_PUBLIC_KEY=pk-lf-6e1a58bf-537c-4b25-9171-7f16aef25560
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://langfuse.vibebrowser.app

# Slack Integration (optional)
# Create a Slack App at https://api.slack.com/apps
# Required scopes: chat:write, channels:history, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_DEFAULT_CHANNEL=#ai-team

# Agent-to-Slack User Mappings (optional)
# Maps agent roles to Slack user IDs for @mentions
# Format: SLACK_AGENT_{ROLE}_USER_ID=U0123456789
# SLACK_AGENT_SWE_USER_ID=U0123456789
# SLACK_AGENT_PM_USER_ID=U0123456789
# SLACK_AGENT_RELEASE_USER_ID=U0123456789
# SLACK_AGENT_SUPPORT_USER_ID=U0123456789

# GitHub Integration (required for most agents)
GITHUB_TOKEN=your-github-token

# Sentry Integration (optional, for ReleaseEngineer)
SENTRY_AUTH_TOKEN=your-sentry-token
