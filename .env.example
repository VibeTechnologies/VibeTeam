# VibeTeam Environment Configuration
# Copy to .env and fill in values

# Azure OpenAI Configuration (required for gpt-5.2 model)
# Get these from Azure Portal > AI Services > info-mjnxtt51-eastus2
AZURE_API_KEY=your-azure-api-key
AZURE_API_BASE=https://info-mjnxtt51-eastus2.cognitiveservices.azure.com/
AZURE_API_VERSION=2024-08-01-preview

# Langfuse Observability (optional)
# Get keys from https://langfuse.vibebrowser.app
LANGFUSE_PUBLIC_KEY=pk-lf-6e1a58bf-537c-4b25-9171-7f16aef25560
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://langfuse.vibebrowser.app

# =====================
# Discord Configuration (recommended for agent handoffs)
# =====================
# Discord uses role-based mentions: 1 bot + 5 roles = simpler than 5 Slack apps

# Bot token from Discord Developer Portal
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token

# Server (guild) and channel IDs
# Right-click in Discord with Developer Mode enabled to copy IDs
DISCORD_GUILD_ID=your-guild-id
DISCORD_CHANNEL_ID=your-channel-id

# Role IDs for agent mentions
# Create mentionable roles in Server Settings > Roles
# Assign all roles to the bot so it receives mention events
DISCORD_ROLE_SWE=
DISCORD_ROLE_RELEASE=
DISCORD_ROLE_SUPPORT=
DISCORD_ROLE_PM=
DISCORD_ROLE_MARKETING=

# Webhook URLs for custom agent identities
# Create webhooks in Channel Settings > Integrations > Webhooks
# Each webhook allows posting with a custom name/avatar
DISCORD_WEBHOOK_SWE=
DISCORD_WEBHOOK_RELEASE=
DISCORD_WEBHOOK_SUPPORT=
DISCORD_WEBHOOK_PM=
DISCORD_WEBHOOK_MARKETING=

# =====================
# Slack Configuration (alternative to Discord)
# =====================
# Slack requires separate apps for each agent identity (more complex)

# Slack bot token (if using Slack instead of Discord)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_DEFAULT_CHANNEL=#ai-team
